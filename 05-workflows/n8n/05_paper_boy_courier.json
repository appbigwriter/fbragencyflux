          "parameter": [
            {
              "name": "agent_name",
              "value": "={{ $json.nextAgent }}"
            },
            {
              "name": "card_id",
              "value": "={{ $json.cardId }}"
            },
            {
              "name": "instruction",
              "value": "=Você recebeu a entrega de {{ $json.agent }}. Prossiga com sua etapa na esteira."
            }
          ]
        }
      },
      "name": "Acionar Próximo Agente no Hermes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [840, 300]
    }
  ],
